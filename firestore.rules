rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'birthDate',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.size() <= 10
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      match /records/{recordId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'category',
            'title',
            'details',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.category in [
            'medicalHistory',
            'chronicCondition',
            'allergy',
            'medication',
            'previousCondition',
            'medicalNote'
          ]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 4000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      match /medications/{medicationId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'name',
            'dosage',
            'doseTime',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'name',
            'dosage',
            'doseTime',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.dosage is string
          && request.resource.data.dosage.size() >= 1
          && request.resource.data.dosage.size() <= 120
          && request.resource.data.doseTime is string
          && request.resource.data.doseTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'name',
            'dosage',
            'doseTime',
            'createdAt',
            'updatedAt',
            'takenDate',
            'takenAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.dosage is string
          && request.resource.data.dosage.size() >= 1
          && request.resource.data.dosage.size() <= 120
          && request.resource.data.doseTime is string
          && request.resource.data.doseTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (
            !('takenDate' in request.resource.data)
            || request.resource.data.takenDate is string
              && request.resource.data.takenDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          )
          && (
            !('takenAt' in request.resource.data)
            || request.resource.data.takenAt is timestamp
          );
      }

      match /passport/{passportId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId
          && passportId == 'current';
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && passportId == 'current'
          && request.resource.data.keys().hasOnly([
            'displayName',
            'bloodType',
            'chronicConditions',
            'drugAllergies',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'displayName',
            'bloodType',
            'chronicConditions',
            'drugAllergies',
            'updatedAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.bloodType in [
            '',
            'A+',
            'A-',
            'B+',
            'B-',
            'AB+',
            'AB-',
            'O+',
            'O-',
            'unknown'
          ]
          && request.resource.data.chronicConditions is string
          && request.resource.data.chronicConditions.size() <= 300
          && request.resource.data.drugAllergies is string
          && request.resource.data.drugAllergies.size() <= 300
          && request.resource.data.updatedAt is timestamp;
      }
    }
  }
}
